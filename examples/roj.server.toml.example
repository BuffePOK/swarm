# roj.toml for the server (~/data/roj.toml of the Linux user roj = /data in the container). See docs/SERVER.md.
timezone = "Europe/Warsaw"

[gateway]
base_url = "http://127.0.0.1:18731/v1"   # apigate on the same host
api_key_env = "ROJ_API_KEY"
timeout_s = 180

[budget]
tokens_per_day = 1000000
usd_per_day = 5.0

[language]
prompt_language = "pl"     # the Meta study measures pl vs en per model family
output_language = "en"

[storage]
# backup_dir = "/backup"   # the bucket, mounted into the container (see roj.container); databases stay on local disk
backup_keep = 14

[selfdev]
clone_url = "https://github.com/<you>/roj.git"   # cloned to /data/repo on first use
github_repo = "<you>/roj"
max_diff_lines = 400

[context]
compact_at_tokens = 24000
keep_turns = 3

[knowledge]
max_tokens = 2500
novelty_threshold = 0.34

[notify]
telegram_chat_id = "123456789"

# --- models -------------------------------------------------------------------------------
# You bind only the minimal team. Every agent the Architect creates for a mission gets a
# concrete model + fallbacks chosen by the Architect from the gateway's catalog (chat models,
# prices, Lab cards: `roj pricing show`, `roj lab cards`). Ids: exact, from `roj models --refresh`.
#
# Required: the two leads, from DIFFERENT families (the Leader checks the Architect's work).
[models.architect]          # plans stages, designs teams, picks models for agents
model = "anthropic/claude-opus-5-5"
fallbacks = ["qwen/qwen4-max"]
[models.leader]             # critiques plans, reviews results against criteria
model = "deepseek/deepseek-v4-pro"
fallbacks = ["mistral/mistral-large-4"]
# Recommended: a cheap, precise model for small internal jobs (summaries of long chats,
# novelty exams, classifications). Without it they fall back to the architect (expensive).
[models.cheap]
model = "gemini/gemini-3.5-flash-lite"
fallbacks = ["deepseek/deepseek-flash"]
#
# Optional overrides of roj's own internal roles (each falls back as shown):
#   planner -> architect, coder -> architect, analyst -> architect, researcher -> architect,
#   critic -> leader, checker -> leader, summarizer/classifier/examiner -> cheap -> architect
# e.g. a dedicated coder for selfdev pull requests:
# [models.coder]
# model = "anthropic/claude-sonnet-5-5"
# fallbacks = ["qwen/kimi-k2.7-code"]

# --- prices (USD per 1M tokens) ------------------------------------------------------------
# Import the gateway's price list once: `roj pricing import /data/apigate-prices.toml` (writes pricing.toml).
# Add models the list does not cover here (entries here win). Unpriced models are budgeted at [pricing.default].
[pricing]
strict = false
[pricing.default]
input = 15.0
output = 75.0
# [pricing.models."qwen/qwen4-max"]
# input = 2.0
# output = 8.0

[permissions]
# Everything from T2 up waits for the owner. Flip one by one when the history justifies it:
# "t2.mission_stage" = "auto"
# "t2.activate_playbook" = "auto"
# "t2.selfdev_start" = "auto"
# "t3.open_pull_request" = "auto"
