# roj.toml for the server (~/data/roj.toml of the Linux user roj = /data in the container). See docs/SERVER.md.
timezone = "Europe/Warsaw"

[gateway]
base_url = "http://127.0.0.1:18731/v1"   # apigate on the same host
api_key_env = "ROJ_API_KEY"
timeout_s = 180

[budget]
tokens_per_day = 1000000
usd_per_day = 5.0

[language]
prompt_language = "pl"     # the Meta study measures pl vs en per model family
output_language = "en"

[storage]
# backup_dir = "/backup"   # the bucket, mounted into the container (see roj.container); databases stay on local disk
backup_keep = 14

[selfdev]
clone_url = "https://github.com/<you>/roj.git"   # cloned to /data/repo on first use
github_repo = "<you>/roj"
max_diff_lines = 400

[context]
compact_at_tokens = 24000
keep_turns = 3

[knowledge]
max_tokens = 2500
novelty_threshold = 0.34

[notify]
telegram_chat_id = "123456789"

# Replace ids with the exact ones from `roj models --refresh`.
[models.architect]         # designs stages and teams in missions (falls back to planner)
model = "claude-opus"
fallbacks = ["gemini-pro"]
[models.planner]
model = "claude-opus"
fallbacks = ["gemini-pro"]
[models.critic]            # the Leader in missions (unless the project sets [leader]); reviews plans and diffs: another family
model = "gpt-sol"
fallbacks = ["gemini-pro"]
[models.coder]
model = "claude-sonnet"
fallbacks = ["deepseek-pro"]
[models.analyst]
model = "claude-sonnet"
fallbacks = ["gemini-pro"]
[models.checker]
model = "gemini-flash"
fallbacks = ["gpt-terra"]
[models.classifier]
model = "gemini-flash-lite"
fallbacks = ["deepseek-flash"]
[models.summarizer]        # compaction of long agent conversations: cheap and precise
model = "gemini-flash-lite"
fallbacks = ["deepseek-flash"]
[models.researcher]        # reads providers' prompting guides in the Meta study
model = "gemini-flash"
fallbacks = ["claude-sonnet"]

[pricing]
strict = false
[pricing.default]
input = 15.0
output = 75.0
# [pricing.models."claude-sonnet*"]
# input = 3.0
# cached_input = 0.3
# output = 15.0

[permissions]
# Everything from T2 up waits for the owner. Flip one by one when the history justifies it:
# "t2.mission_stage" = "auto"
# "t2.activate_playbook" = "auto"
# "t2.selfdev_start" = "auto"
# "t3.open_pull_request" = "auto"
