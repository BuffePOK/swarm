# ~/roj.env   (chmod 600) - read by the container; never commit, never paste into a chat
# Required: the key of your gateway (apigate: sk-gate-...)
ROJ_API_KEY=
# Optional: approvals and reports in Telegram (token from @BotFather)
ROJ_TELEGRAM_TOKEN=
# Optional: lets selfdev push a branch and open a pull request. Fine-grained token, only the roj
# repository, permissions "Contents: read and write" and "Pull requests: read and write".
ROJ_GITHUB_TOKEN=
# Optional: a general web search provider ([search] provider = "tavily" or "brave"); research works without it
ROJ_SEARCH_KEY=
# Optional: free Semantic Scholar API key (own rate limit instead of the shared one that often answers 429)
ROJ_S2_KEY=
